rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && (request.auth.token.email_verified == true || (request.auth.uid == 'cookie-zookie-owner-key' && request.auth.token.get('ownerKey',false) == true && request.auth.token.firebase.sign_in_provider == 'password')); }
    function email() { return request.auth.token.email.lower(); }
    function role() { return get(/databases/$(database)/documents/teamAccess/$(email())).data.role; }
    function staff() { return verified() && role() in ['owner', 'admin', 'employee']; }
    function manager() { return verified() && role() in ['owner', 'admin']; }
    function owner() { return verified() && role() == 'owner'; }
    function visitor() { return verified() && (!exists(/databases/$(database)/documents/teamAccess/$(email())) || role() != 'blocked'); }
    function oldShop() { return get(/databases/$(database)/documents/loja/dados).data; }
    function newShop() { return getAfter(/databases/$(database)/documents/loja/dados).data; }
    function event(id) { return getAfter(/databases/$(database)/documents/auditV2/$(id)).data; }
    function ticket(id) { return getAfter(/databases/$(database)/documents/saleRequests/$(request.auth.uid)/items/$(id)).data; }
    function core(s) { return { 'products': s.products, 'sales': s.sales, 'customers': s.customers }; }
    function validId(id) { return id is string && id.matches('^v2-[a-f0-9-]{36}$'); }
    function tiedToStore(id) {
      let s = newShop();
      return validId(id) && s.auditId == id && s.updatedAt == request.time && s.updatedBy == request.auth.uid;
    }
    function changedStore(s) {
      let e = event(s.auditId);
      return validId(s.auditId) && e.id == s.auditId && e.createdAt == request.time && e.actorUid == request.auth.uid
        && (e.action == 'venda' || (existsAfter(/databases/$(database)/documents/auditSnapshots/$(s.auditId)/versions/before)
        && existsAfter(/databases/$(database)/documents/auditSnapshots/$(s.auditId)/versions/after)))
        && getAfter(/databases/$(database)/documents/catalog/products).data == { 'products': s.products, 'revision': s.auditId }
        && getAfter(/databases/$(database)/documents/saleRegistry/ids).data.revision == s.auditId
        && getAfter(/databases/$(database)/documents/dashboard/public).data.revision == s.auditId;
    }
    function financialRecord(source, id) {
      return source == 'purchase' ? getAfter(/databases/$(database)/documents/ownerPurchases/$(id)) : getAfter(/databases/$(database)/documents/ownerPayments/$(id));
    }
    function financialValid(source, recordId, auditId) {
      return validId(auditId) && event(auditId).action == 'financeiro' && event(auditId).source == source
        && event(auditId).recordId == recordId && event(auditId).actorUid == request.auth.uid
        && event(auditId).createdAt == request.time && financialRecord(source, recordId).data.auditId == auditId
        && existsAfter(/databases/$(database)/documents/auditSnapshots/$(auditId)/versions/before)
        && existsAfter(/databases/$(database)/documents/auditSnapshots/$(auditId)/versions/after);
    }
    function oldFinancialRecord(source, recordId) {
      return source == 'purchase'
        ? (exists(/databases/$(database)/documents/ownerPurchases/$(recordId))
          ? (get(/databases/$(database)/documents/ownerPurchases/$(recordId)).data.deleted
            ? {'deleted': true} : {'data': get(/databases/$(database)/documents/ownerPurchases/$(recordId)).data.data, 'deleted': false}) : null)
        : (exists(/databases/$(database)/documents/ownerPayments/$(recordId))
          ? (get(/databases/$(database)/documents/ownerPayments/$(recordId)).data.deleted
            ? {'deleted': true} : {'data': get(/databases/$(database)/documents/ownerPayments/$(recordId)).data.data, 'deleted': false}) : null);
    }
    function newFinancialRecord(source, recordId) {
      return source == 'purchase'
        ? (getAfter(/databases/$(database)/documents/ownerPurchases/$(recordId)).data.deleted
          ? {'deleted': true} : {'data': getAfter(/databases/$(database)/documents/ownerPurchases/$(recordId)).data.data, 'deleted': false})
        : (getAfter(/databases/$(database)/documents/ownerPayments/$(recordId)).data.deleted
          ? {'deleted': true} : {'data': getAfter(/databases/$(database)/documents/ownerPayments/$(recordId)).data.data, 'deleted': false});
    }
    function linkedPaymentValid(recordId, auditId) {
      return validId(auditId) && event(auditId).action == 'alteracao' && event(auditId).source == 'payment'
        && event(auditId).recordId == recordId && event(auditId).actorUid == request.auth.uid
        && event(auditId).createdAt == request.time && tiedToStore(auditId)
        && event(auditId).financialBefore == oldFinancialRecord('payment', recordId)
        && event(auditId).financialAfter == newFinancialRecord('payment', recordId)
        && financialRecord('payment', recordId).data.auditId == auditId;
    }
    function baseStoreValid(s) {
      return s.products is list && s.products.size() <= 500 && s.sales is list && s.sales.size() <= 5000
        && s.customers is list && s.customers.size() <= 2000 && s.schemaVersion == 2
        && s.updatedAt == request.time && s.updatedBy == request.auth.uid && s.updatedByEmail == email()
        && s.diff(resource.data).affectedKeys().hasOnly(['products','sales','customers','schemaVersion','auditId','updatedAt','updatedBy','updatedByEmail']);
    }
    function selectedProducts(p, i) {
      return i.size() == 1 ? [p[i[0]]] : i.size() == 2 ? [p[i[0]],p[i[1]]] : i.size() == 3 ? [p[i[0]],p[i[1]],p[i[2]]] : i.size() == 4 ? [p[i[0]],p[i[1]],p[i[2]],p[i[3]]] : [p[i[0]],p[i[1]],p[i[2]],p[i[3]],p[i[4]]];
    }
    function validItemAt(b, a, sale, indices, n) {
      let i = indices[n];
      let item = sale.items[n];
      let before = b.products[i];
      let after = a.products[i];
      return i is int && i >= 0 && i < b.products.size()
        && item.keys().hasOnly(['productId','name','qty','unitPrice'])
        && item.productId == before.id && item.name == before.name && item.unitPrice == before.price
        && item.qty is int && item.qty > 0 && item.qty <= 100000
        && after.diff(before).affectedKeys().hasOnly(['stock'])
        && after.stock == before.stock - item.qty && after.stock >= 0;
    }
    function validItem(b, a, sale, indices, n) { return n >= sale.items.size() || validItemAt(b, a, sale, indices, n); }
    function itemTotal(s, n) { return n < s.items.size() ? s.items[n].qty * s.items[n].unitPrice : 0; }
    function validDate(value) {
      let parts = value.split('[-T:.Z]');
      let at = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]))
        + duration.value(int(parts[3]), 'h') + duration.value(int(parts[4]), 'm') + duration.value(int(parts[5]), 's');
      return value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$')
        && at >= request.time - duration.value(5, 'm') && at <= request.time + duration.value(1, 'm');
    }
    function validSale(b, a) {
      let e = event(a.auditId);
      let t = ticket(e.saleId);
      let s = t.sale;
      let total = itemTotal(s, 0) + itemTotal(s, 1) + itemTotal(s, 2) + itemTotal(s, 3) + itemTotal(s, 4);
      return e.action == 'venda' && t.auditId == a.auditId && t.createdAt == request.time
        && s.keys().hasOnly(['id','date','items','payment','total','channel','status','paidAmount','customerId'])
        && s.id == e.saleId && s.id is string && s.id.size() > 0 && s.id.size() <= 100
        && s.status in ['Pago','Pendente'] && s.payment in ['pix','dinheiro','cartão'] && s.channel in ['loja','delivery','encomenda']
        && s.paidAmount == (s.status == 'Pago' ? s.total : 0) && s.total >= total - 0.01 && s.total <= total + 0.01
        && s.total >= 0 && s.total <= 1000000 && s.date is string && validDate(s.date)
        && s.items is list && s.items.size() >= 1 && s.items.size() <= 5
        && t.indices is list && t.indices.size() == s.items.size() && t.indices.toSet().size() == t.indices.size()
        && a.products.size() == b.products.size()
        && a.products.removeAll(selectedProducts(a.products,t.indices)) == b.products.removeAll(selectedProducts(b.products,t.indices))
        && a.customers == b.customers && a.sales == b.sales.concat([s])
        && !(s.id in get(/databases/$(database)/documents/saleRegistry/ids).data.ids)
        && (s.get('customerId','') == '' ? s.status == 'Pago' && t.customerIndex == -1 :
          t.customerIndex is int && t.customerIndex >= 0 && t.customerIndex < b.customers.size() && b.customers[t.customerIndex].id == s.customerId);
    }
    function receiptItems(t) {
      let b = oldShop();
      let a = newShop();
      return validItem(b,a,t.sale,t.indices,0) && validItem(b,a,t.sale,t.indices,1)
        && validItem(b,a,t.sale,t.indices,2) && validItem(b,a,t.sale,t.indices,3) && validItem(b,a,t.sale,t.indices,4);
    }
    function auditHeader(id, e) {
      return e.id == id && validId(id) && e.actorUid == request.auth.uid && e.email == email()
        && e.actor is string && e.actor.size() > 0 && e.actor.size() <= 120 && e.detail is string && e.detail.size() <= 1000
        && e.createdAt == request.time && e.hasUndo is bool && e.undoOf is string;
    }
    match /ownerPayments/{id} {
      allow read: if manager();
      allow create, update: if manager() && request.resource.data.keys().hasOnly(['data','deleted','updatedAt','auditId'])
        && (financialValid('payment', id, request.resource.data.auditId) || linkedPaymentValid(id, request.resource.data.auditId))
        && request.resource.data.updatedAt == request.time && request.resource.data.deleted is bool
        && (request.resource.data.deleted == true || (request.resource.data.data is map
          && request.resource.data.data.id == id && request.resource.data.data.amount is number
          && request.resource.data.data.amount > 0 && request.resource.data.data.amount <= 1000000
          && request.resource.data.data.description is string && request.resource.data.data.description.size() > 0 && request.resource.data.data.description.size() <= 500
          && request.resource.data.data.person is string && request.resource.data.data.person.size() <= 200
          && request.resource.data.data.date is string));
      allow delete: if false;
    }
    match /ownerPurchases/{id} {
      allow read: if owner();
      allow create, update: if owner() && request.resource.data.keys().hasOnly(['data','deleted','updatedAt','auditId'])
        && financialValid('purchase', id, request.resource.data.auditId)
        && request.resource.data.updatedAt == request.time && request.resource.data.deleted is bool
        && (request.resource.data.deleted == true || (request.resource.data.data is map
          && request.resource.data.data.id == id && request.resource.data.data.items is list
          && request.resource.data.data.items.size() <= 1000 && request.resource.data.data.date is string
          && !('photo' in request.resource.data.data)));
      allow delete: if false;
    }
    match /customerReceipts/{customerId}/entries/{receiptId} {
      allow read: if manager();
      allow create: if manager() && request.resource.data.keys().hasOnly(['id','customerId','amount','payment','date','recordedAt','actor','actorUid','allocations','kind','auditId','requestHash'])
        && request.resource.data.id == receiptId && request.resource.data.customerId == customerId
        && request.resource.data.recordedAt == request.time && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actor is string && request.resource.data.actor.size() > 0 && request.resource.data.actor.size() <= 120
        && request.resource.data.auditId is string && request.resource.data.allocations is list
        && request.resource.data.allocations.size() > 0 && request.resource.data.allocations.size() <= 1000
        && request.resource.data.allocations[0].saleId is string
        && (request.resource.data.kind == 'receipt'
          ? request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000
            && request.resource.data.payment in ['dinheiro','cartão','pix']
            && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.requestHash is string && request.resource.data.requestHash.size() <= 20
            && event(request.resource.data.auditId).action == 'recebimento'
            && event(request.resource.data.auditId).receiptId == receiptId
            && event(request.resource.data.auditId).customerId == customerId
            && event(request.resource.data.auditId).amount == request.resource.data.amount
            && event(request.resource.data.auditId).allocations == request.resource.data.allocations
            && event(request.resource.data.auditId).requestHash == request.resource.data.requestHash
          : request.resource.data.kind == 'adjustment' && request.resource.data.amount is number
            && request.resource.data.amount >= -1000000 && request.resource.data.amount <= 1000000
            && !('payment' in request.resource.data) && !('date' in request.resource.data)
            && event(request.resource.data.auditId).action in ['alteracao','desfazer']
            && event(request.resource.data.auditId).actorUid == request.auth.uid);
      allow update, delete: if false;
    }
    match /customerReceiptAliases/{customerId} {
      allow read: if manager();
      allow create: if manager() && request.resource.data.keys().hasOnly(['customerId','sources','auditId','updatedAt','actorUid'])
        && request.resource.data.customerId == customerId && request.resource.data.sources is list && request.resource.data.sources.size() <= 350
        && request.resource.data.updatedAt == request.time && request.resource.data.actorUid == request.auth.uid
        && validId(request.resource.data.auditId) && event(request.resource.data.auditId).action == 'alteracao'
        && event(request.resource.data.auditId).actorUid == request.auth.uid;
      allow update: if manager() && request.resource.data.keys().hasOnly(['customerId','sources','auditId','updatedAt','actorUid'])
        && request.resource.data.customerId == customerId && request.resource.data.sources is list && request.resource.data.sources.size() <= 350
        && request.resource.data.sources.hasAll(resource.data.sources) && request.resource.data.updatedAt == request.time
        && request.resource.data.actorUid == request.auth.uid && validId(request.resource.data.auditId)
        && event(request.resource.data.auditId).action == 'alteracao' && event(request.resource.data.auditId).actorUid == request.auth.uid;
      allow delete: if false;
    }
    match /deviceFinancial/{uid}/devices/{deviceId} {
      allow read: if manager() && request.auth.uid == uid;
      allow create, update: if manager() && request.auth.uid == uid && deviceId.matches('^[a-f0-9-]{36}$');
      allow delete: if false;
      match /records/{recordKey} {
        allow read: if manager();
        allow create, update: if manager() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['source','recordId','deviceId','actorUid','lastAuditId','data','deleted','updatedAt'])
          && request.resource.data.source in ['cost','loss'] && request.resource.data.recordId is string
          && request.resource.data.deviceId == deviceId && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.lastAuditId is string && request.resource.data.updatedAt == request.time
          && request.resource.data.deleted is bool
          && (request.resource.data.deleted ? request.resource.data.data == null : request.resource.data.data is map)
          && event(request.resource.data.lastAuditId).action == 'financeiro'
          && event(request.resource.data.lastAuditId).source == request.resource.data.source
          && event(request.resource.data.lastAuditId).recordKey == recordKey
          && event(request.resource.data.lastAuditId).recordId == request.resource.data.recordId
          && event(request.resource.data.lastAuditId).deviceId == deviceId
          && event(request.resource.data.lastAuditId).originUid == uid
          && event(request.resource.data.lastAuditId).actorUid == request.auth.uid
          && event(request.resource.data.lastAuditId).createdAt == request.time
          && event(request.resource.data.lastAuditId).after == request.resource.data.data
          && getAfter(/databases/$(database)/documents/auditSnapshots/$(request.resource.data.lastAuditId)/versions/after).data.record == request.resource.data.data;
        allow delete: if false;
      }
    }
    match /loja/dados {
      allow read: if manager();
      allow update: if staff() && baseStoreValid(request.resource.data) && changedStore(request.resource.data)
        && (event(request.resource.data.auditId).action == 'venda' ? validSale(resource.data, request.resource.data) :
          manager() && event(request.resource.data.auditId).action in ['alteracao','desfazer','recebimento']
          && getAfter(/databases/$(database)/documents/catalog/customers).data.revision == request.resource.data.auditId);
      allow create, delete: if false;
    }
    match /catalog/products {
      allow read: if visitor();
      allow create, update: if tiedToStore(request.resource.data.revision)
        && request.resource.data == { 'products': newShop().products, 'revision': newShop().auditId };
      allow delete: if false;
    }
    match /catalog/customers {
      allow read: if staff();
      allow create, update: if event(request.resource.data.revision).action != 'venda' && request.resource.data.keys().hasOnly(['customers','revision'])
        && tiedToStore(request.resource.data.revision) && request.resource.data.customers is list
        && request.resource.data.customers.size() == newShop().customers.size();
      allow delete: if false;
    }
    match /saleRegistry/ids {
      allow read: if manager();
      allow update: if request.resource.data.keys().hasOnly(['ids','revision']) && tiedToStore(request.resource.data.revision)
        && request.resource.data.ids is list && request.resource.data.ids.hasAll(resource.data.ids)
        && (event(newShop().auditId).action != 'venda' || request.resource.data.ids == resource.data.ids.concat([event(newShop().auditId).saleId]));
      allow create, delete: if false;
    }
    match /saleRequests/{uid}/items/{id} {
      allow get: if verified() && (request.auth.uid == uid || manager());
      allow list: if manager();
      allow create: if uid == request.auth.uid && request.resource.data.keys().hasOnly(['sale','indices','customerIndex','fingerprint','auditId','createdAt'])
        && request.resource.data.sale.id == id && receiptItems(request.resource.data) && tiedToStore(request.resource.data.auditId)
        && event(request.resource.data.auditId).action == 'venda' && event(request.resource.data.auditId).saleId == id
        && request.resource.data.createdAt == request.time && request.resource.data.fingerprint is string && request.resource.data.fingerprint.size() <= 30000;
      allow update, delete: if false;
    }
    match /auditV2/{id} {
      allow read: if owner();
      allow create: if auditHeader(id, request.resource.data)
        && (request.resource.data.action == 'equipe' ? owner()
          && request.resource.data.keys().hasOnly(['id','actorUid','actor','email','createdAt','action','detail','hasUndo','undoOf','targetEmail','beforeRole','afterRole'])
          && request.resource.data.hasUndo == false && request.resource.data.undoOf == ''
          && getAfter(/databases/$(database)/documents/teamAccess/$(request.resource.data.targetEmail)).data.auditId == id
          && getAfter(/databases/$(database)/documents/teamAccess/$(request.resource.data.targetEmail)).data.updatedAt == request.time
          && request.resource.data.afterRole == getAfter(/databases/$(database)/documents/teamAccess/$(request.resource.data.targetEmail)).data.role
          && request.resource.data.beforeRole == (exists(/databases/$(database)/documents/teamAccess/$(request.resource.data.targetEmail)) ? get(/databases/$(database)/documents/teamAccess/$(request.resource.data.targetEmail)).data.role : 'blocked')
        : request.resource.data.action == 'financeiro'
          ? request.resource.data.keys().hasOnly(['id','actorUid','actor','email','createdAt','action','detail','hasUndo','undoOf','source','recordId','originUid','deviceId','recordKey','baselineDeclared','before','after'])
            && request.resource.data.hasUndo == false && request.resource.data.undoOf == ''
            && request.resource.data.source in ['purchase','payment','cost','loss'] && request.resource.data.recordId is string
            && (request.resource.data.source in ['cost','loss']
              ? manager() && request.resource.data.originUid == request.auth.uid
                && request.resource.data.deviceId is string && request.resource.data.deviceId.matches('^[a-f0-9-]{36}$')
                && request.resource.data.recordKey is string
                && request.resource.data.baselineDeclared is bool
                && (request.resource.data.before == null || request.resource.data.before is map)
                && (request.resource.data.after == null || request.resource.data.after is map)
                && existsAfter(/databases/$(database)/documents/deviceFinancial/$(request.auth.uid)/devices/$(request.resource.data.deviceId)/records/$(request.resource.data.recordKey))
                && getAfter(/databases/$(database)/documents/deviceFinancial/$(request.auth.uid)/devices/$(request.resource.data.deviceId)/records/$(request.resource.data.recordKey)).data.lastAuditId == id
                && getAfter(/databases/$(database)/documents/deviceFinancial/$(request.auth.uid)/devices/$(request.resource.data.deviceId)/records/$(request.resource.data.recordKey)).data.recordId == request.resource.data.recordId
                && getAfter(/databases/$(database)/documents/deviceFinancial/$(request.auth.uid)/devices/$(request.resource.data.deviceId)/records/$(request.resource.data.recordKey)).data.data == request.resource.data.after
                && getAfter(/databases/$(database)/documents/deviceFinancial/$(request.auth.uid)/devices/$(request.resource.data.deviceId)/records/$(request.resource.data.recordKey)).data.deleted == (request.resource.data.after == null)
              : request.resource.data.source == 'purchase'
              ? owner() && getAfter(/databases/$(database)/documents/ownerPurchases/$(request.resource.data.recordId)).data.auditId == id
              : manager() && getAfter(/databases/$(database)/documents/ownerPayments/$(request.resource.data.recordId)).data.auditId == id)
            && existsAfter(/databases/$(database)/documents/auditSnapshots/$(id)/versions/before)
            && existsAfter(/databases/$(database)/documents/auditSnapshots/$(id)/versions/after)
          : request.resource.data.action == 'alteracao' && request.resource.data.get('source', '') == 'payment'
            ? tiedToStore(id) && manager() && request.resource.data.keys().hasOnly(['id','actorUid','actor','email','createdAt','action','detail','hasUndo','undoOf','source','recordId','financialBefore','financialAfter'])
              && request.resource.data.hasUndo == false && request.resource.data.undoOf == ''
              && request.resource.data.recordId is string && request.resource.data.financialBefore == oldFinancialRecord('payment', request.resource.data.recordId)
              && request.resource.data.financialAfter == newFinancialRecord('payment', request.resource.data.recordId)
              && getAfter(/databases/$(database)/documents/ownerPayments/$(request.resource.data.recordId)).data.auditId == id
          : tiedToStore(id) && (request.resource.data.action == 'recebimento'
          ? request.resource.data.keys().hasOnly(['id','actorUid','actor','email','createdAt','action','detail','hasUndo','undoOf','receiptId','customerId','amount','payment','date','allocations','requestHash'])
            && manager() && request.resource.data.hasUndo == false && request.resource.data.undoOf == ''
            && request.resource.data.receiptId is string && request.resource.data.customerId is string
            && request.resource.data.amount is number && request.resource.data.payment in ['dinheiro','cartão','pix']
            && request.resource.data.date is string && request.resource.data.allocations is list && request.resource.data.requestHash is string
          : request.resource.data.keys().hasOnly(['id','actorUid','actor','email','createdAt','action','detail','hasUndo','undoOf','saleId','sale','beforeProducts','afterProducts'])
          && (request.resource.data.action != 'venda' || (request.resource.data.beforeProducts == oldShop().products && request.resource.data.afterProducts == newShop().products && request.resource.data.sale == ticket(request.resource.data.saleId).sale))
          && (request.resource.data.action == 'desfazer' ? owner() && request.resource.data.hasUndo == false
            && getAfter(/databases/$(database)/documents/auditReversals/$(request.resource.data.undoOf)).data.auditId == id
            : request.resource.data.action in ['venda','alteracao'] && request.resource.data.hasUndo == true && request.resource.data.undoOf == '')));
      allow update, delete: if false;
    }
    match /auditSnapshots/{id}/versions/{version} {
      allow read: if manager() && !exists(/databases/$(database)/documents/auditV2/$(id))
        || manager() && exists(/databases/$(database)/documents/auditV2/$(id)) && (event(id).action != 'financeiro' || event(id).source != 'purchase')
        || owner() && event(id).action == 'financeiro' && event(id).source == 'purchase';
      allow create: if event(id).action == 'financeiro' && event(id).source in ['cost','loss']
        ? version in ['before','after'] && request.resource.data.keys().hasOnly(['source','recordId','deviceId','baselineDeclared','recordKey','record'])
          && request.resource.data.source == event(id).source && request.resource.data.recordId == event(id).recordId
          && request.resource.data.deviceId == event(id).deviceId && request.resource.data.baselineDeclared == event(id).baselineDeclared
          && request.resource.data.recordKey == event(id).recordKey && manager()
          && event(id).originUid == request.auth.uid && event(id).recordKey.matches('^(cost|loss)_.{1,400}$')
          && (version == 'before'
            ? (exists(/databases/$(database)/documents/deviceFinancial/$(request.auth.uid)/devices/$(event(id).deviceId)/records/$(event(id).recordKey))
              ? !event(id).baselineDeclared && request.resource.data.record == get(/databases/$(database)/documents/deviceFinancial/$(request.auth.uid)/devices/$(event(id).deviceId)/records/$(event(id).recordKey)).data.data
              : event(id).baselineDeclared)
            : request.resource.data.record == event(id).after)
          && (version != 'before' || request.resource.data.record == event(id).before)
        : event(id).action == 'financeiro'
        ? version in ['before','after'] && request.resource.data.keys().hasOnly(['source','recordId','record'])
          && request.resource.data.source == event(id).source && request.resource.data.recordId == event(id).recordId
          && (event(id).source == 'purchase' ? owner() : manager())
          && request.resource.data.record == (version == 'before'
            ? oldFinancialRecord(event(id).source, event(id).recordId) : newFinancialRecord(event(id).source, event(id).recordId))
          && financialValid(event(id).source, event(id).recordId, id)
        : tiedToStore(id) && version in ['before','after']
        && (version == 'before' ? request.resource.data == (event(id).action == 'venda' ?
          { 'products': oldShop().products, 'sales': [], 'customers': [] } : core(oldShop())) :
          request.resource.data == (event(id).action == 'venda' ?
          { 'products': newShop().products, 'sales': [ticket(event(id).saleId).sale], 'customers': [] } : core(newShop())));
      allow update, delete: if false;
    }
    match /auditReversals/{id} {
      allow read: if owner();
      allow create: if owner() && request.resource.data.keys().hasOnly(['auditId','actorUid','createdAt'])
        && request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/auditV2/$(id)).data.hasUndo == true
        && event(request.resource.data.auditId).undoOf == id && event(request.resource.data.auditId).action == 'desfazer'
        && tiedToStore(request.resource.data.auditId);
      allow update, delete: if false;
    }
    match /teamAccess/{address} {
      allow get: if verified() && (email() == address || owner());
      allow list: if owner();
      allow create, update: if owner() && address != email() && request.resource.data.email == address
        && (!exists(/databases/$(database)/documents/teamAccess/$(address)) || resource.data.role != 'owner')
        && request.resource.data.role in ['owner','admin','employee','viewer','blocked']
        && request.resource.data.keys().hasOnly(['email','role','auditId','updatedAt']) && request.resource.data.updatedAt == request.time
        && event(request.resource.data.auditId).action == 'equipe' && event(request.resource.data.auditId).targetEmail == address
        && event(request.resource.data.auditId).actorUid == request.auth.uid && event(request.resource.data.auditId).createdAt == request.time;
      allow delete: if false;
    }
    match /loginProfiles/{address} {
      allow get: if verified() && (email() == address || owner());
      allow list: if owner();
      allow create, update: if verified() && address == email()
        && request.resource.data.keys().hasOnly(['uid','email','name','lastSeen'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.email == email()
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.lastSeen == request.time;
      allow delete: if false;
    }
    match /dashboard/public {
      allow read: if visitor();
      allow create, update: if tiedToStore(request.resource.data.revision)
        && request.resource.data.keys().hasOnly(['sales','revision'])
        && request.resource.data.sales is list
        && (event(request.resource.data.revision).action != 'venda' ? manager() :
          request.resource.data.sales == resource.data.sales.concat([{
            'id': ticket(event(request.resource.data.revision).saleId).sale.id,
            'date': ticket(event(request.resource.data.revision).saleId).sale.date,
            'items': ticket(event(request.resource.data.revision).saleId).sale.items,
            'status': ticket(event(request.resource.data.revision).saleId).sale.status
          }]));
      allow delete: if false;
    }
    match /audit/{id} { allow read: if owner(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
