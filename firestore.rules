rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function role() { return get(/databases/$(database)/documents/team/$(request.auth.uid)).data.role; }
    function manager() { return verified() && role() in ['owner', 'admin']; }
    function owner() { return verified() && role() == 'owner'; }
    match /team/{uid} {
      allow get: if verified() && (request.auth.uid == uid || owner());
      allow list: if owner();
      allow write: if false;
    }
    match /invitations/{id} { allow read: if owner(); allow write: if false; }
    match /loja/{id} { allow read: if id == 'dados' && manager(); allow write: if false; }
    match /audit/{id} { allow read: if manager(); allow write: if false; }
    match /auditReversals/{id} { allow read: if manager(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
