{
  "name": "cookie-app-v2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build && node scripts/service-worker.mjs",
    "preview": "vite preview",
    "verify": "npm run typecheck && npm test && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test": "node scripts/test.mjs",
    "build:backend": "tsc -p functions/tsconfig.json && node scripts/build-functions.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "prebuild": "node scripts/prepare-ocr.mjs",
    "predev": "node scripts/prepare-ocr.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/por": "1.0.0",
    "firebase": "^12.18.0",
    "idb-keyval": "6.3.0",
    "lucide-react": "^0.453.0",
    "react": "^18.2.0",
    "react-dom": "^19.2.8",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "react-test-renderer": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
