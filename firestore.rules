rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function validStoreData() {
      return request.resource.data.keys().hasOnly([
          'products', 'sales', 'customers', 'schemaVersion',
          'updatedAt', 'updatedBy', 'updatedByEmail', 'pendencias'
        ])
        && request.resource.data.products is list
        && request.resource.data.products.size() <= 500
        && request.resource.data.sales is list
        && request.resource.data.sales.size() <= 5000
        && request.resource.data.customers is list
        && request.resource.data.customers.size() <= 2000
        && request.resource.data.schemaVersion == 2
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == request.auth.token.email;
    }

    match /loja/dados {
      allow read: if verifiedUser();
      allow create, update: if verifiedUser() && validStoreData();
      allow delete: if false;
    }

    // Append-only: o cliente não pode apagar nem reescrever rastros existentes.
    match /audit/{entryId} {
      allow read: if verifiedUser();
      allow create: if verifiedUser()
        && request.resource.data.keys().hasOnly(['id', 'ts', 'actor', 'email', 'action', 'detail'])
        && entryId == request.resource.data.id
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 100
        && request.resource.data.ts is int
        && request.resource.data.actor is string
        && request.resource.data.actor.size() > 0
        && request.resource.data.actor.size() <= 120
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 60
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 1000
        && (!('email' in request.resource.data)
          || request.resource.data.email == request.auth.token.email);
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
