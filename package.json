{
  "name": "cookie-app-v2",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build && node scripts/service-worker.mjs",
    "preview": "vite preview",
    "verify": "npm run typecheck && npm test && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test": "node scripts/test.mjs",
    "build:backend": "tsc -p functions/tsconfig.json && node scripts/build-functions.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "prebuild": "node scripts/prepare-ocr.mjs",
    "predev": "node scripts/prepare-ocr.mjs",
    "native:sync": "npm run build && npx cap sync",
    "android": "npm run native:sync && npx cap open android",
    "ios": "npm run native:sync && npx cap open ios",
    "desktop": "electron electron-main.cjs",
    "desktop:build": "npm run desktop:icon && electron-builder --win portable",
    "desktop:icon": "node scripts/generate-desktop-icon.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/por": "1.0.0",
    "firebase": "^12.18.0",
    "idb-keyval": "6.3.0",
    "lucide-react": "^0.453.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react-test-renderer": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.cookiezookie.gestao",
    "productName": "Cookie Zookie",
    "compression": "normal",
    "npmRebuild": false,
    "directories": { "output": "release" },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "electron-main.cjs",
      "electron-preload.cjs",
      "public/icon-512.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "build/icon.ico"
    }
  }
}
